{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "receita",
        "despesa"
      ],
      "description": "Tipo da transa\u00e7\u00e3o - receita (entrada) ou despesa (sa\u00edda)"
    },
    "amount": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "salario",
        "freelance",
        "investimentos",
        "outras_receitas",
        "alimentacao",
        "transporte",
        "moradia",
        "contas",
        "saude",
        "educacao",
        "lazer",
        "compras",
        "outros_gastos"
      ],
      "description": "Categoria da transa\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da transa\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da transa\u00e7\u00e3o"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "pix",
        "transferencia"
      ],
      "description": "Forma de pagamento"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pago",
        "a_pagar"
      ],
      "default": "pago",
      "description": "Status de pagamento da despesa"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento (para despesas a pagar)"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Data em que foi efetivamente paga"
    },
    "recurring": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma despesa recorrente"
    },
    "recurring_day": {
      "type": "number",
      "description": "Dia do m\u00eas para despesas recorrentes (1-31)"
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ]
}