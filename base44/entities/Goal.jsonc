{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da meta (ex: Viagem para Europa)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da meta"
    },
    "target_amount": {
      "type": "number",
      "description": "Valor total da meta"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 economizado"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Data alvo para atingir a meta"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_progresso",
        "concluida",
        "cancelada"
      ],
      "default": "em_progresso",
      "description": "Status da meta"
    },
    "icon": {
      "type": "string",
      "description": "\u00cdcone representativo da meta"
    },
    "color": {
      "type": "string",
      "description": "Cor para visualiza\u00e7\u00e3o"
    }
  },
  "required": [
    "title",
    "target_amount"
  ]
}