{
  "name": "FamilyMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do membro da fam\u00edlia"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do membro (para enviar convite)"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "viewer"
      ],
      "default": "editor",
      "description": "N\u00edvel de permiss\u00e3o: admin (total), editor (edita suas transa\u00e7\u00f5es), viewer (apenas visualiza)"
    },
    "color": {
      "type": "string",
      "description": "Cor para identifica\u00e7\u00e3o visual"
    },
    "avatar": {
      "type": "string",
      "description": "Emoji ou inicial para avatar"
    },
    "invited_by": {
      "type": "string",
      "description": "Email de quem convidou"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "inactive"
      ],
      "default": "pending",
      "description": "Status do convite/membro"
    },
    "joined_date": {
      "type": "string",
      "format": "date",
      "description": "Data que aceitou o convite"
    }
  },
  "required": [
    "name",
    "email",
    "role"
  ]
}